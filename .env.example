GEO_USER_AGENT=scanzakaz/1.0 (ваш@email)

# --- Redis (на Vercel - Upstash, схема rediss://) ---
REDIS_URL=

# --- YooKassa (вопрос 8) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
