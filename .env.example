# --- MAX (вопросы 1–3) ---
MAX_BOT_TOKEN=
MAX_API_BASE=https://botapi.max.ru
MAX_WEBHOOK_SECRET=
USE_LONG_POLLING=false # Для Vercel всегда false!

# --- GigaChat (вопрос 7) ---
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_BASE=https://gigachat.devices.sberbank.ru/api/v1

# --- Yandex Vision + Geocoder (вопрос 6) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_OCR_URL=https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/1.x

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- YooKassa (вопрос 8) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_bot # Любая ваша ссылка
YOOKASSA_RECEIPT_ENABLED=false # НПД = чек не нужен

# --- Продукт ---
PRICE_WEEK=1490
PRICE_MONTH=4950
CHECKS_PER_DAY=30
TRIAL_CHECKS=10

# --- Экономика материалов ---
LABOR_SHARE_LOW=0.55
LABOR_SHARE_HIGH=0.70
LABOR_SHARE_BUFFER=1.10

DEBUG=false
